# Keep the Docker build context small. The image installs gnn-vuln from PyPI (no local
# wheel build), so only API/ is needed — src/ and the repo configs/ tree are excluded
# (model configs travel with each model as a DB snapshot; bundled defaults live in API/configs).
.git
.venv
API/.venv
src/
/configs/
**/__pycache__
**/*.pyc
**/*.pyo

# Large runtime artifacts — bind-mounted at runtime, never baked into the image
data/
checkpoints/
results/
logs/
runs/
wandb/

# Heavy non-code trees
paper/
docs/
node_modules/
.pytest_cache
.ruff_cache
.ipynb_checkpoints

# Build / cache outputs
dist/
build/
*.egg-info/
*.pt
*.tar.gz
*.zip
API/storage/
API/app.db
API/jobs/
API/tests/
API/_config_cache/
